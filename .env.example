APP_ENV=production
APP_NAME=MD HUB FINAL
APP_VERSION=1.0.0-web
SERVER_HOST=0.0.0.0
SERVER_PORT=8765

# Gerar com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=trocar-por-segredo-longo-e-aleatorio
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Postgres gerenciado (Neon / Vercel Postgres). Nunca usar sqlite em producao.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/mdhub?sslmode=require

# Dominios do frontend autorizados a chamar esta API, separados por virgula.
# Nunca deixar "*" em producao (o middleware ja desativa allow_credentials quando ve "*").
CORS_ORIGINS=https://SEU-FRONTEND.vercel.app

MIDIASIMPLES_BASE_URL=https://api.arklok.midiasimples.com.br
MIDIASIMPLES_EMAIL=
MIDIASIMPLES_PASSWORD=
AUTOMATOS_BASE_URL=https://lad2-smartcenter.almaden.app
AUTOMATOS_ID=
AUTOMATOS_SECURITY_KEY=
SYNC_HUB_URL=
SYNC_INGEST_TOKEN=

# WhatsApp (Selenium/Chrome) e IA (Ollama) ficam desabilitados no deploy Vercel: nao rodam em
# funcao serverless. Ver DOCUMENTACAO_MIGRACAO_WEB_CLAUDE.md secao 9 antes de reativar.
AI_ENABLED=false
AI_PILOT_ENABLED=false
AI_PROVIDER=ollama
OLLAMA_BASE_URL=
OLLAMA_MODEL=
OLLAMA_VISION_MODEL=
